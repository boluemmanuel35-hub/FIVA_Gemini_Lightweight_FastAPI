# Local development only.
# On Render/Vercel, add these in the platform Environment Variables UI.

GEMINI_API_KEY=put_your_gemini_api_key_here

# These defaults match the generated knowledge JSON.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Free-tier generation model at the time this project was created.
GEMINI_GENERATION_MODEL=gemini-3.8-flash

FIVA_TOP_K=4
